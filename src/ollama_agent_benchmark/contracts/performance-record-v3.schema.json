{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oab:performance-record:3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "execution_key", "measurement_key", "status", "eligible_for_main_score", "power_condition", "model", "workload_id", "temperature_state", "cold_unload_verified", "run_index", "started_at_utc", "completed_at_utc", "wall_seconds", "metrics", "model_ps", "swap_before_bytes", "swap_after_bytes", "swap_delta_bytes", "runner_error", "workload_compliance", "exchange"],
  "properties": {
    "schema_version": {"const": 3},
    "run_id": {"type": "string", "minLength": 1},
    "execution_key": {"type": "string", "minLength": 1},
    "measurement_key": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "execution_failure"]},
    "eligible_for_main_score": {"type": "boolean"},
    "power_condition": {"enum": ["ac_power", "battery", "unknown", "not_applicable"]},
    "model": {"type": "string", "minLength": 1},
    "workload_id": {"type": "string", "minLength": 1},
    "temperature_state": {"enum": ["cold", "hot"]},
    "cold_unload_verified": {"type": ["boolean", "null"]},
    "run_index": {"type": "integer", "minimum": 1},
    "started_at_utc": {"type": "string", "minLength": 1},
    "completed_at_utc": {"type": "string", "minLength": 1},
    "wall_seconds": {"type": ["number", "null"], "minimum": 0},
    "metrics": {"type": "object", "additionalProperties": {"type": ["number", "null"]}},
    "model_ps": {"type": ["object", "null"]},
    "swap_before_bytes": {"type": ["integer", "null"]},
    "swap_after_bytes": {"type": ["integer", "null"]},
    "swap_delta_bytes": {"type": ["integer", "null"]},
    "runner_error": {"type": ["string", "null"]},
    "workload_compliance": {"type": "object", "additionalProperties": false, "required": ["valid", "checks", "failed_checks"], "properties": {
      "valid": {"type": "boolean"}, "checks": {"type": "object", "additionalProperties": {"type": "boolean"}}, "failed_checks": {"type": "array", "items": {"type": "string"}}
    }},
    "exchange": {"type": "object"}
  }
}
