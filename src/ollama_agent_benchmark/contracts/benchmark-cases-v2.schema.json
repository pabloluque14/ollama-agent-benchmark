{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:oab:benchmark-cases:2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "suite_id", "description", "counts", "cases"],
  "properties": {
    "schema_version": {"const": 2}, "suite_id": {"type": "string", "minLength": 1}, "description": {"type": "string"},
    "counts": {"type": "object", "additionalProperties": false, "required": ["tool_reliability", "quality_reasoning", "total"], "properties": {
      "tool_reliability": {"type": "integer", "minimum": 0}, "quality_reasoning": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 1}
    }},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {"type": "object", "additionalProperties": false, "required": ["id", "title", "track", "category", "messages", "allowed_tools", "fixture_plan", "expected"], "properties": {
      "id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1},
      "track": {"enum": ["tool_reliability", "quality_reasoning"]}, "category": {"type": "string", "minLength": 1},
      "messages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/message"}},
      "allowed_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "fixture_plan": {"type": "array", "items": {"type": "object"}},
      "expected": {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {
        "mode": {"type": "string", "minLength": 1}, "steps": {"type": "array", "items": {"type": "object"}},
        "final": {"type": "object"}, "forbidden_tools": {"type": "array", "items": {"type": "string"}},
        "no_sensitive_tool_call": {"type": "boolean"}, "no_tool_call": {"type": "boolean"},
        "must_contain": {"type": "array", "items": {"type": "string"}}, "must_contain_any": {"type": "array", "items": {"type": "string"}},
        "must_not_contain": {"type": "array", "items": {"type": "string"}}, "exact": {}, "value": {}, "tolerance": {"type": "number"}
      }}
    }},
    "message": {"type": "object", "additionalProperties": false, "required": ["role", "content"], "properties": {
      "role": {"enum": ["user", "assistant", "system"]}, "content": {"type": "string"}
    }}
  }
}
