{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oab:planning-inputs:3",
  "title": "Ollama Agent Benchmark planning inputs v3 (versioned source documents)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "config", "lock"],
  "properties": {
    "schema_version": {"const": 3},
    "config": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "benchmark_version", "models", "ollama", "generation", "functional", "order_control", "performance", "weights", "speed_weights", "workload_weights", "missing_metric_policy"],
      "properties": {
        "schema_version": {"const": 3},
        "benchmark_version": {"const": "0.3.0"},
        "models": {"$ref": "#/$defs/names"},
        "ollama": {"type": "object", "additionalProperties": false, "required": ["base_url"],
          "properties": {"base_url": {"$ref": "#/$defs/nonempty"}}},
        "generation": {"type": "object", "additionalProperties": false,
          "required": ["num_ctx", "temperature", "seed", "top_k", "top_p", "min_p", "repeat_penalty", "presence_penalty", "num_predict", "think"],
          "properties": {
            "num_ctx": {"$ref": "#/$defs/positive_int"}, "temperature": {"type": "number"},
            "seed": {"type": "integer"}, "top_k": {"$ref": "#/$defs/positive_int"},
            "top_p": {"type": "number"}, "min_p": {"type": "number"},
            "repeat_penalty": {"type": "number"}, "presence_penalty": {"type": "number"},
            "num_predict": {"$ref": "#/$defs/positive_int"}, "think": {"type": "boolean"}}},
        "functional": {"type": "object", "additionalProperties": false,
          "required": ["repetitions", "max_turns", "keep_alive", "pause_between_models_seconds", "smoke_pause_seconds"],
          "properties": {
            "repetitions": {"$ref": "#/$defs/positive_int"}, "max_turns": {"$ref": "#/$defs/positive_int"},
            "keep_alive": {"$ref": "#/$defs/nonempty"},
            "pause_between_models_seconds": {"$ref": "#/$defs/nonnegative_int"},
            "smoke_pause_seconds": {"$ref": "#/$defs/nonnegative_int"}}},
        "order_control": {"type": "object", "additionalProperties": false, "required": ["seed", "policy"],
          "properties": {"seed": {"type": "integer"}, "policy": {"$ref": "#/$defs/nonempty"}}},
        "performance": {"type": "object", "additionalProperties": false,
          "required": ["cold_runs", "hot_runs", "ttft_runs", "keep_alive", "pause_after_unload_seconds", "pause_between_models_seconds"],
          "properties": {
            "cold_runs": {"$ref": "#/$defs/positive_int"}, "hot_runs": {"$ref": "#/$defs/positive_int"},
            "ttft_runs": {"$ref": "#/$defs/nonnegative_int"}, "keep_alive": {"$ref": "#/$defs/nonempty"},
            "pause_after_unload_seconds": {"$ref": "#/$defs/nonnegative_number"},
            "pause_between_models_seconds": {"$ref": "#/$defs/nonnegative_number"}}},
        "weights": {"type": "object", "additionalProperties": false,
          "required": ["tool_reliability", "quality_reasoning", "speed", "memory_stability"],
          "properties": {"tool_reliability": {"$ref": "#/$defs/nonnegative_number"}, "quality_reasoning": {"$ref": "#/$defs/nonnegative_number"}, "speed": {"$ref": "#/$defs/nonnegative_number"}, "memory_stability": {"$ref": "#/$defs/nonnegative_number"}}},
        "speed_weights": {"type": "object", "additionalProperties": false,
          "required": ["generation", "prompt", "hot_latency", "ttft", "cold_load"],
          "properties": {"generation": {"$ref": "#/$defs/nonnegative_number"}, "prompt": {"$ref": "#/$defs/nonnegative_number"}, "hot_latency": {"$ref": "#/$defs/nonnegative_number"}, "ttft": {"$ref": "#/$defs/nonnegative_number"}, "cold_load": {"$ref": "#/$defs/nonnegative_number"}}},
        "workload_weights": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/positive_number"}},
        "missing_metric_policy": {"const": "incomplete_score"}
      }
    },
    "lock": {"type": ["object", "null"], "additionalProperties": false,
      "required": ["schema_version", "benchmark_version", "ollama_base_url", "ollama_server_version", "models"],
      "properties": {
        "schema_version": {"const": 3}, "benchmark_version": {"const": "0.3.0"},
        "created_at_utc": {"$ref": "#/$defs/nonempty"},
        "ollama_base_url": {"$ref": "#/$defs/nonempty"},
        "ollama_server_version": {"$ref": "#/$defs/nonempty"},
        "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/locked_model"}}
      }
    }
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "positive_int": {"type": "integer", "minimum": 1},
    "nonnegative_int": {"type": "integer", "minimum": 0},
    "nonnegative_number": {"type": "number", "minimum": 0},
    "positive_number": {"type": "number", "exclusiveMinimum": 0},
    "names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
    "locked_model": {"type": "object", "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": {"$ref": "#/$defs/nonempty"}, "digest": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "modified_at": {"type": ["string", "null"]},
        "format": {"type": ["string", "null"]}, "family": {"type": ["string", "null"]},
        "parameter_size": {"type": ["string", "null"]}, "quantization_level": {"type": ["string", "null"]},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "requires_ollama": {"type": ["string", "array", "null"], "items": {"type": "string"}},
        "architecture_metadata": {"type": "object", "additionalProperties": {"type": ["string", "integer", "null"]}},
        "default_parameters": {"type": "string"},
        "template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "modelfile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
